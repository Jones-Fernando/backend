# Ambiente
APP_ENV=development
HOST=127.0.0.1
PORT=5000

# Banco
DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=wepay_db

# Apenas para testes automatizados com SQLite
TEST_DB_PATH=wepay_test.sqlite3

# JWT
SECRET_KEY=troque-por-uma-chave-segura-e-unica
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRES_DAYS=30

# Rate limit
RATE_LIMIT_STORAGE_URI=memory://
RATE_LIMIT_LOGIN=5 per minute
RATE_LIMIT_REGISTER=10 per hour

# CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Email
EMAIL_REMETENTE=
EMAIL_SENHA_APP=
EMAIL_SERVER=smtp.gmail.com
EMAIL_PORT=465
FRONTEND_URL=http://localhost:8081
ALLOW_EMAIL_TEST=false
